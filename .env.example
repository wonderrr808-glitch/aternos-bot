# --- Discord ---
DISCORD_TOKEN=
# Optional: only react in this channel / for members with this role
ALLOWED_CHANNEL_ID=
ALLOWED_ROLE_ID=
COOLDOWN_SECONDS=120

# --- Aternos ---
ATERNOS_USERNAME=
ATERNOS_PASSWORD=
# Optional: data-id of the server card on https://aternos.org/servers/ (needed if you own several)
ATERNOS_SERVER_ID=

# --- Browser ---
# true = headless. false = headed (Docker image wraps it in Xvfb; passes Turnstile more often, uses more RAM)
HEADLESS=true
# Path to chrome/chromium (auto-detected on Linux; set manually on Windows/macOS)
CHROME_PATH=
# Optional custom UA. Leave empty to let the stealth plugin derive a consistent one.
USER_AGENT=
PROFILE_DIR=./.browser-profile

# --- Behaviour ---
MAX_WAIT_MINUTES=15
# Ad patience: wait at least N s after pressing Start before closing any ad,
# require the Close button to stay visible for N s, and only look inside ad iframes after N s.
AD_MIN_WATCH_SECONDS=10
AD_CLOSE_SETTLE_SECONDS=3
AD_IFRAME_FALLBACK_SECONDS=45
# Timeouts in seconds - raise these on slow hosts (Render free tier) if steps time out
CLOUDFLARE_TIMEOUT_SECONDS=60
LOGIN_TIMEOUT_SECONDS=45
ELEMENT_TIMEOUT_SECONDS=30
NAVIGATION_TIMEOUT_SECONDS=60
START_VERIFY_TIMEOUT_SECONDS=120
# Weak-host helpers (all optional, off by default)
LITE_MODE=false
LOW_MEMORY=false
ANNOUNCE_RESTART=false
EARLY_FINISH=false
PORT=3000
